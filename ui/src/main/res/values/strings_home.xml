    <!-- HelpScreen -->
    <string name="help_title">Помощь</string>
    <string name="help_back">Назад</string>
    <string name="help_app_title">Samlib — читалка</string>
    <string name="help_app_description">Неофициальный клиент библиотеки СамИздат (samlib.ru): новинки, поиск, авторы, топы, обзоры, обсуждения, комментарии и иллюстрации, офлайн-чтение и озвучка.</string>
    <string name="help_sections_title">Разделы меню</string>
    <string name="help_sections_text">• Лента: новинки и поиск.\n• Каталог: Топ авторов, Обзоры, Обсуждения, Избранное.\n• Моё: история чтения и отслеживаемые авторы (подписки).\n• Ещё: настройки, помощь, открытие сохранённого файла.</string>
    <string name="help_reading_title">Чтение</string>
    <string name="help_reading_text">В читалке доступны настройки шрифта/темы (шестерёнка), автопрокрутка, озвучка (TTS), сохранение на устройство и иллюстрации — через меню «⋮».</string>
    <string name="help_open_samlib">Открыть samlib.ru</string>
